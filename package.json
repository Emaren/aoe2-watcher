{
  "name": "aoe2-watcher",
  "version": "1.6.5",
  "description": "AoE2HDBets Replay Watcher",
  "author": "AoE2HDBets",
  "license": "ISC",
  "main": "main.js",
  "productName": "AoE2HDBets Watcher",
  "desktopName": "com.aoe2hdbets.watcher.desktop",
  "scripts": {
    "start": "electron main.js",
    "lint": "node --check main.js && node --check watcher.js && node --check replayProvenancePolicy.js && node --check telemetryQueue.js && node --check runtimeTelemetryContract.js && node --check telemetryDelivery.js && node --check runtimeJournalQueue.js && node --check networkPriority.js && node --check runtimePolicy.js && node --check updatePolicy.js && node --check resourceProfile.js && node --check rendererHealth.js && node --check captureSourceDiagnostics.js && node --check captureSourcePolicy.js && node --check runTests.js && node --check renderer.js && node --check war-room-player.js && node --check war-room-locale.js && node --check war-room.js && node --check preload.js && node --check scripts/sync-release-docs.mjs && node --check scripts/verify-mac-updater.cjs && node --check scripts/benchmark-telemetry-queue.cjs",
    "test": "node runTests.js",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg zip --arm64",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:manual-zip": "node scripts/build-manual-zip.mjs",
    "verify:mac-updater": "node scripts/verify-mac-updater.cjs",
    "dist:release": "npm run dist:win && npm run dist:mac && npm run dist:manual-zip && npm run dist:linux",
    "docs:release-sync": "node scripts/sync-release-docs.mjs",
    "benchmark:telemetry": "node scripts/benchmark-telemetry-queue.cjs"
  },
  "build": {
    "appId": "com.aoe2hdbets.watcher",
    "productName": "AoE2HDBets Watcher",
    "protocols": [
      {
        "name": "AoE2HDBets Watcher Pairing",
        "schemes": [
          "aoe2hd-watcher"
        ]
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "telemetryQueue.js",
      "runtimeTelemetryContract.js",
      "telemetryDelivery.js",
      "runtimeJournalQueue.js",
      "networkPriority.js",
      "watcher.js",
      "replayProvenancePolicy.js",
      "streamHandoff.js",
      "captureSourceDiagnostics.js",
      "captureSourcePolicy.js",
      "runtimePolicy.js",
      "updatePolicy.js",
      "resourceProfile.js",
      "rendererHealth.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "war-room-player.js",
      "war-room-locale.js",
      "war-room.js",
      "war-room.css",
      "build/**/*",
      "package.json",
      ".env.example",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "CFBundleDisplayName": "AoE2HDBets Watcher",
        "CFBundleName": "AoE2HDBets Watcher",
        "NSHumanReadableCopyright": "© AoE2HDBets"
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "AoE2HDBets Watcher",
          "Comment": "AoE2HDBets replay watcher",
          "StartupWMClass": "com.aoe2hdbets.watcher"
        }
      }
    },
    "dmg": {
      "title": "AoE2HDBets Watcher",
      "iconSize": 128,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AoE2HDBets Watcher",
      "uninstallDisplayName": "AoE2HDBets Watcher",
      "installerLanguages": [
        "en_US"
      ]
    },
    "afterSign": "scripts/notarize.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://aoe2war.com/downloads"
      }
    ]
  },
  "keywords": [],
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^16.5.0",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "electron": "^43.7.2",
    "electron-builder": "^26.15.3"
  }
}
