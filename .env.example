# Required only if you do not want the default production endpoint.
AOE2_API_BASE_URL=https://api-prodn.aoe2war.com
AOE2_API_FALLBACK_BASE_URL=https://aoe2war.com
AOE2_TELEMETRY_BASE_URL=https://aoe2war.com

# Optional: set custom replay folder path.
# AOE2_WATCH_DIR=/path/to/Age2HD/SaveGame

# Optional: override uploader identity value sent as x-user-uid.
# WATCHER_USER_UID=your-uid-here

# Optional: override the stable watcher id generated by the app.
# AOE2_WATCHER_ID=watcher_your_stable_id

# Optional manual fallback: one-click profile pairing normally saves this for you.
# AOE2_UPLOAD_API_KEY=replace-with-watcher-key

# Optional timing knobs for support builds.
# AOE2_TELEMETRY_HEARTBEAT_MS=60000
# AOE2_UPLOAD_QUIET_PERIOD_MS=120000
# AOE2_FINAL_CANDIDATE_MIN_AGE_MS=480000
# AOE2_FINAL_CANDIDATE_COOLDOWN_MS=180000
# AOE2_FINAL_CANDIDATE_STABLE_SAMPLES=3
# AOE2_FINAL_SETTLE_WINDOW_MS=180000
